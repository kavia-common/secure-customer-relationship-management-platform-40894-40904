# FastAPI Backend Configuration (.env.example)
# Copy to .env and adjust values as needed. Do NOT commit your real secrets.

# Application
APP_NAME=CRM FastAPI Backend
APP_VERSION=0.1.0
BACKEND_PORT=3001

# Security / Auth
# Token TTL in seconds (default 1 hour)
TOKEN_TTL_SECONDS=3600
AUDIT_ENABLED=true

# CORS: allow comma-separated origins
# Supports CORS_ALLOW_ORIGINS or CORS_ORIGINS (either works)
CORS_ALLOW_ORIGINS=http://localhost:3000

# Database (optional in preview)
# If not set, app runs in degraded mode and health endpoint still works.
# Example: postgresql://user:password@localhost:5432/crm
# DATABASE_URL=postgresql://postgres:postgres@localhost:5432/crm

# Optional path to SQL migrations (directory containing .sql files)
# MIGRATIONS_PATH=/migrations
