# Example environment configuration for CRM FastAPI backend

# Application
APP_NAME="CRM FastAPI Backend"
APP_VERSION="0.1.0"

# Database (required for functional endpoints)
# Format: postgresql://USER:PASSWORD@HOST:PORT/DBNAME
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/crm_db"

# CORS
# Comma-separated list; default is http://localhost:3000
CORS_ORIGINS="http://localhost:3000"

# Security / Auth
# Bearer token TTL (seconds)
TOKEN_TTL_SECONDS=3600

# Rate limiting (per IP)
RATE_LIMIT_REQUESTS=100
RATE_LIMIT_WINDOW_SECONDS=60

# Migrations (optional): directory path where .sql files are mounted from the DB container
MIGRATIONS_PATH="/migrations"

# Toggle audit logging (true/false)
AUDIT_ENABLED=true
