# CRM FastAPI Backend - Environment configuration example
# Copy to .env and adjust values for your environment.

# App metadata (optional)
APP_NAME=CRM FastAPI Backend
APP_VERSION=0.1.0

# Server binding
# The orchestrator will map this to your preview port; default is 3001
BACKEND_PORT=3001

# CORS configuration (comma-separated list)
# Default allows local React dev server
CORS_ALLOW_ORIGINS=http://localhost:3000

# Authentication / sessions
# Token TTL in seconds (default 3600 = 1 hour)
TOKEN_TTL_SECONDS=3600

# Rate limiting (optional)
RATE_LIMIT_REQUESTS=100
RATE_LIMIT_WINDOW_SECONDS=60

# Database connection (PostgreSQL)
# Example pointing to postgres on port 5000.
# Update host/user/pass/db as appropriate.
# Do not set this to run in DB-degraded mode (service will still start; DB-backed endpoints will fail).
DATABASE_URL=postgresql://postgres:postgres@localhost:5000/crmdb

# Path to SQL migrations directory (optional)
# If provided, the service will attempt to apply .sql files on startup.
# MIGRATIONS_PATH=/app/migrations

# Audit logging toggle
AUDIT_ENABLED=true
